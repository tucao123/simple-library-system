<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>修改图书 - 图书管理系统</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://code.jquery.com/jquery-1.8.3.min.js"></script>
</head>
<body>
  <div class="container">
    <h1>修改图书信息</h1>

    <% if (message) { %>
      <div class="alert alert-<%= messageType %>"><%= message %></div>
    <% } %>

    <form id="editForm" action="/books/edit/<%= book.bookId %>" method="POST">
      <table class="form-table">
        <tr>
          <th><span class="required">*</span> 图书编号：</th>
          <td><input type="text" name="bookCode" id="bookCode" value="<%= book.bookCode %>" required></td>
        </tr>
        <tr>
          <th><span class="required">*</span> 图书名称：</th>
          <td><input type="text" name="bookName" id="bookName" value="<%= book.bookName %>" required></td>
        </tr>
        <tr>
          <th><span class="required">*</span> 图书类型：</th>
          <td>
            <select name="bookType" id="bookType" required>
              <option value="">请选择</option>
              <% types.forEach(type => { %>
                <option value="<%= type.id %>" <%= type.id === book.bookType ? 'selected' : '' %>>
                  <%= type.typeName %>
                </option>
              <% }) %>
            </select>
          </td>
        </tr>
        <tr>
          <th><span class="required">*</span> 作者：</th>
          <td><input type="text" name="bookAuthor" id="bookAuthor" value="<%= book.bookAuthor %>" required></td>
        </tr>
        <tr>
          <th><span class="required">*</span> 出版社：</th>
          <td><input type="text" name="publishPress" id="publishPress" value="<%= book.publishPress %>" required></td>
        </tr>
        <tr>
          <th><span class="required">*</span> 出版日期：</th>
          <td><input type="date" name="publishDate" id="publishDate" value="<%= formatShortDate(book.publishDate) %>" required></td>
        </tr>
        <tr>
          <th><span class="required">*</span> 是否借阅：</th>
          <td>
            <select name="borrowed" id="borrowed">
              <option value="0" <%= book.borrowed === 0 ? 'selected' : '' %>>未借阅</option>
              <option value="1" <%= book.borrowed === 1 ? 'selected' : '' %>>已借阅</option>
            </select>
          </td>
        </tr>
        <tr>
          <th>入库人：</th>
          <td><input type="text" name="createdBy" value="<%= book.createdBy %>" readonly class="readonly"></td>
        </tr>
        <tr>
          <th>入库时间：</th>
          <td><input type="text" value="<%= formatDate(book.creationTime) %>" readonly class="readonly"></td>
        </tr>
      </table>

      <div class="form-actions">
        <button type="submit">修改</button>
        <button type="button" onclick="location.href='/books'">返回</button>
      </div>
    </form>
  </div>

  <script>
    $(document).ready(function() {
      $('#editForm').submit(function(e) {
        const required = ['#bookCode', '#bookName', '#bookType', '#bookAuthor', '#publishPress', '#publishDate'];
        for (let field of required) {
          if (!$(field).val()) {
            e.preventDefault();
            alert('请填写所有必填项！');
            return false;
          }
        }
      });
    });
  </script>
</body>
</html>
